---
import "../styles/global.css";
interface Props{title:string}
const {title}=Astro.props;
const base=import.meta.env.BASE_URL;
const link=(path:string)=>base+path.replace(/^\//,"");
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Public TIGRESS-NCR releases from LIT."/><meta name="theme-color" content="#071521"/><link rel="icon" href={link("/favicon.svg")}/><title>{title} · LIT Data</title></head><body>
<a class="skip" href="#main">Skip to content</a>
<header><a class="brand" href={link("/")}><b>LIT</b><span><strong>Learning the ISM with TIGRESS</strong><small>Public data portal · prototype</small></span></a><nav><a href={link("/")}>Overview</a><a href={link("/explore/")}>Explore</a><a href={link("/documentation/")}>Documentation</a><a href={link("/releases/")}>Releases</a></nav><a class="button compact" href={link("/releases/")}>Get data</a></header>
<main id="main"><slot/></main>
<footer><div><strong>LIT public data portal</strong><p>Design prototype · no public payload yet</p></div><nav><a href={link("/explore/")}>Explore</a><a href={link("/documentation/")}>Documentation</a><a href={link("/releases/")}>Releases</a></nav></footer>
</body></html>
