---
import Base from "../layouts/Base.astro";
import models from "../data/models.json";
const products=["History","Phases","PRFM","PDF","Spectrum"];
---
<Base title="Explore simulations"><section class="page-hero"><p class="eyebrow">Synthetic model catalog</p><h1>Explore the suite</h1><p>Test the path from environment to data. These four records are interface fixtures, not released metadata.</p></section>
<section class="section explorer" data-model-explorer data-models={JSON.stringify(models)}>
<form class="filters" aria-label="Filter models"><p class="label">FILTERS</p>
<label for="f-search">Search<input id="f-search" type="search" data-search placeholder="Model or product"/></label>
<label for="f-omega">Maximum Ω<select id="f-omega" data-omega><option value="999">All</option><option value="30">≤ 30</option><option value="50">≤ 50</option></select></label>
<fieldset><legend>Has products</legend>{products.map(p=><label for={`p-${p}`}><input id={`p-${p}`} type="checkbox" value={p} data-product/>{p}</label>)}</fieldset>
<button type="reset" data-reset>Reset</button></form>
<div class="results"><p><b data-count>{models.length}</b> synthetic models shown</p>
<div class="table"><table><thead><tr><th scope="col">Model</th><th scope="col" class="num">Σgas</th><th scope="col" class="num">Σstar</th><th scope="col" class="num">Ω</th><th scope="col" class="num">q</th><th scope="col">Products</th></tr></thead><tbody data-body>{models.map(m=><tr><td><b>{m.label}</b><small class="badge">Historical mapping</small></td><td class="num">{m.sigmaGas}</td><td class="num">{m.sigmaStar}</td><td class="num">{m.omega}</td><td class="num">{m.q}</td><td><span class="chips">{m.products.map(p=><span class="chip">{p}</span>)}</span></td></tr>)}</tbody></table></div>
<p class="fixture">Synthetic fixtures only. Public model parameters will be generated from a reviewed release catalog.</p></div>
</section>
<script>
const root=document.querySelector("[data-model-explorer]");
if(root instanceof HTMLElement){const models=JSON.parse(root.dataset.models||"[]"),search=root.querySelector("[data-search]"),omega=root.querySelector("[data-omega]"),checks=[...root.querySelectorAll("[data-product]")].filter((c):c is HTMLInputElement=>c instanceof HTMLInputElement),body=root.querySelector("[data-body]"),count=root.querySelector("[data-count]"),form=root.querySelector("form");
const esc=(v:unknown)=>String(v).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
function render(){if(!(search instanceof HTMLInputElement)||!(omega instanceof HTMLSelectElement)||!(body instanceof HTMLElement))return;const q=search.value.toLowerCase(),max=Number(omega.value),want=checks.filter(c=>c.checked).map(c=>c.value);const shown=models.filter((m:any)=>(m.label+" "+m.products.join(" ")).toLowerCase().includes(q)&&m.omega<=max&&want.every(p=>m.products.includes(p)));body.innerHTML=shown.map((m:any)=>"<tr><td><b>"+esc(m.label)+"</b><small class='badge'>Historical mapping</small></td><td class='num'>"+esc(m.sigmaGas)+"</td><td class='num'>"+esc(m.sigmaStar)+"</td><td class='num'>"+esc(m.omega)+"</td><td class='num'>"+esc(m.q)+"</td><td><span class='chips'>"+m.products.map((p:unknown)=>"<span class='chip'>"+esc(p)+"</span>").join("")+"</span></td></tr>").join("");if(count)count.textContent=String(shown.length)}
search?.addEventListener("input",render);omega?.addEventListener("change",render);checks.forEach(c=>c.addEventListener("change",render));form?.addEventListener("submit",e=>e.preventDefault());form?.addEventListener("reset",()=>setTimeout(render));}
</script></Base>
