---
import Base from "../layouts/Base.astro";
import models from "../data/models.json";
---
<Base title="Explore simulations"><section class="page-hero"><p class="eyebrow">Synthetic model catalog</p><h1>Explore the suite</h1><p>Test the path from environment to data. These four records are interface fixtures, not released metadata.</p></section>
<section class="section explorer" data-model-explorer data-models={JSON.stringify(models)}><div class="filters"><label>Search<input type="search" data-search placeholder="Model or product"/></label><label>Maximum Ω<select data-omega><option value="999">All</option><option value="30">≤ 30</option><option value="50">≤ 50</option></select></label><label>Product<select data-product><option value="all">All</option><option>History</option><option>Phases</option><option>PRFM</option><option>PDF</option><option>Spectrum</option></select></label><button data-reset>Reset</button></div><p><b data-count>{models.length}</b> synthetic models shown</p><div class="table"><table><thead><tr><th>Model</th><th>Σgas</th><th>Σstar</th><th>Ω</th><th>q</th><th>Products</th></tr></thead><tbody data-body>{models.map(m=><tr><td><b>{m.label}</b><small class="badge">Historical mapping</small></td><td>{m.sigmaGas}</td><td>{m.sigmaStar}</td><td>{m.omega}</td><td>{m.q}</td><td>{m.products.join(" · ")}</td></tr>)}</tbody></table></div><p class="fixture">Synthetic fixtures only. Public model parameters will be generated from a reviewed release catalog.</p></section>
<script>
const root=document.querySelector("[data-model-explorer]");
if(root instanceof HTMLElement){const models=JSON.parse(root.dataset.models||"[]"),search=root.querySelector("[data-search]"),omega=root.querySelector("[data-omega]"),product=root.querySelector("[data-product]"),body=root.querySelector("[data-body]"),count=root.querySelector("[data-count]");
const esc=(v:unknown)=>String(v).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
function render(){if(!(search instanceof HTMLInputElement)||!(omega instanceof HTMLSelectElement)||!(product instanceof HTMLSelectElement)||!(body instanceof HTMLElement))return;const q=search.value.toLowerCase(),max=Number(omega.value),p=product.value;const shown=models.filter((m:any)=>(m.label+" "+m.products.join(" ")).toLowerCase().includes(q)&&m.omega<=max&&(p==="all"||m.products.includes(p)));body.innerHTML=shown.map((m:any)=>"<tr><td><b>"+esc(m.label)+"</b><small class='badge'>Historical mapping</small></td><td>"+esc(m.sigmaGas)+"</td><td>"+esc(m.sigmaStar)+"</td><td>"+esc(m.omega)+"</td><td>"+esc(m.q)+"</td><td>"+m.products.map(esc).join(" · ")+"</td></tr>").join("");if(count)count.textContent=String(shown.length)}
search?.addEventListener("input",render);omega?.addEventListener("change",render);product?.addEventListener("change",render);root.querySelector("[data-reset]")?.addEventListener("click",()=>{if(search instanceof HTMLInputElement)search.value="";if(omega instanceof HTMLSelectElement)omega.value="999";if(product instanceof HTMLSelectElement)product.value="all";render()});}
</script></Base>
