---
import Base from "../layouts/Base.astro";
const base=import.meta.env.BASE_URL;
const link=(path:string)=>base+path.replace(/^\//,"");
---
<Base title="Public TIGRESS-NCR data">
<div class="notice"><b>Design prototype</b><span>Synthetic metadata only · no public payload or DOI yet</span></div>
<section class="hero wrap"><div><p class="eyebrow">A public simulation laboratory for the interstellar medium</p><h1>Learning the ISM<br/><em>with TIGRESS</em></h1><p class="lede">Explore how galactic environment shapes the phases, structure, and self-regulation of the interstellar medium in radiation-MHD simulations.</p><div class="actions"><a class="button" href={link("/explore/")}>Explore simulations</a><a class="button outline" href={link("/releases/")}>View planned release</a></div></div>
<div class="art" role="img" aria-label="Abstract layered view of a galactic disk"><svg viewBox="0 0 620 470" aria-hidden="true"><defs><radialGradient id="g"><stop stop-color="#f2b84a"/><stop offset=".3" stop-color="#38c8b4" stop-opacity=".7"/><stop offset="1" stop-color="#071521" stop-opacity="0"/></radialGradient></defs><ellipse cx="310" cy="240" rx="270" ry="110" fill="none" stroke="#38c8b4" opacity=".25"/><ellipse cx="310" cy="240" rx="200" ry="80" fill="none" stroke="#38c8b4" opacity=".4"/><ellipse cx="310" cy="240" rx="130" ry="55" fill="url(#g)" opacity=".8"/><path d="M55 260C170 160 225 330 335 220S510 205 570 255" fill="none" stroke="#67ead8" stroke-width="6" opacity=".8"/><path d="M55 220C155 310 250 165 360 265S505 310 570 215" fill="none" stroke="#f2b84a" stroke-width="4" opacity=".8"/><g fill="#fff0bd"><circle cx="130" cy="235" r="4"/><circle cx="210" cy="280" r="5"/><circle cx="295" cy="230" r="4"/><circle cx="385" cy="270" r="5"/><circle cx="485" cy="228" r="4"/></g></svg><small>Synthetic visual placeholder</small></div></section>
<section class="metrics"><div><small>Release</small><b>v1.0 planned</b></div><div><small>Core suite</small><b>40 models</b></div><div><small>Resolution</small><b>8 pc</b></div><div><small>Transfer</small><b>Globus planned</b></div><div><small>Citation</small><b>DOI pending</b></div></section>
<section class="section"><div class="intro"><p class="eyebrow dark">Why LIT?</p><h2>From galactic environment to a living, multiphase ISM</h2><p>The portal will connect every executed environment to analysis-ready products, provenance, and reproducible examples.</p></div><div class="cards"><article><span>01</span><h3>Vary the environment</h3><p>Compare gas, stellar gravity, rotation, and shear across a controlled suite.</p></article><article><span>02</span><h3>Resolve the cycle</h3><p>Follow radiation, feedback, chemistry, turbulence, and vertical equilibrium.</p></article><article><span>03</span><h3>Analyze reproducibly</h3><p>Use versioned catalogs, checksums, public readers, and examples.</p></article></div></section>
<section class="dark-panel"><div><p class="eyebrow">Explore parameter space</p><h2>Find the environment you need</h2><p>Filter a compact catalog, then transfer only the appropriate bundles from Globus.</p><a href={link("/explore/")}>Open the synthetic explorer →</a></div><div class="plot"><i style="--x:14%;--y:24%"></i><i style="--x:34%;--y:40%"></i><i style="--x:56%;--y:58%"></i><i style="--x:80%;--y:78%"></i><small>Σstar → &nbsp; · &nbsp; Ω ↑</small></div></section>
<section class="section"><div class="intro"><p class="eyebrow dark">A simple path</p><h2>Choose. Transfer. Analyze.</h2></div><ol class="steps"><li><b>1</b><div><h3>Choose</h3><p>Inspect parameters, products, and limitations.</p></div></li><li><b>2</b><div><h3>Transfer</h3><p>Select versioned bundles in Globus.</p></div></li><li><b>3</b><div><h3>Analyze</h3><p>Verify checksums and use public Python tools.</p></div></li></ol></section>
</Base>
